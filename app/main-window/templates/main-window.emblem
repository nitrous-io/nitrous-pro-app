if App.updater.updateInfo
  .update-info
    if App.updater.checking
      | Checking for update
    if App.updater.updating
      | Updating
      if App.updater.downloading
        if App.updater.progress
          '
          = App.updater.progress
          | %

if App.hosts
  ul.host-list
    each host in App.hosts
      li
        h3.host-name
          = host.displayName
        ul.container-list
          each container in host.containers
            = view 'container-control' content=container

unless App.hosts
  unless App.sharedContainers
    .containing
      .notice
        p You don't have any workspaces
        button click='createHost' Create a new workspace

if App.sharedContainers
  ul.host-list
    li
      h3.host-name
        | Shared Containers
      ul.container-list
        each container in App.sharedContainers
          = view 'container-control' content=container
