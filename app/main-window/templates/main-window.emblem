.sidebar
  ul.host-list
    each host in App.hosts
      li
        = host.displayName
        ul.container-list
          each container in host.containers
            li class={container.selected:selected} click='selectContainer container'
              = container.displayName
.content
  if App.selectedContainer
    h2
      = App.selectedContainer.displayName
    = ui-sync-switch on=App.selectedContainer.syncEnabled
