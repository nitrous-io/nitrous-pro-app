.sidebar
  ul.host-list
    each host in App.hosts
      li
        = host.displayName
        ul.container-list
          each container in host.containers
            li class={container.selected:selected} click='selectContainer container'
              = container.displayName
.content
  p
    | signed in as&nbsp;
    = App.username
  with App.selectedContainer
    h2
      = displayName
    if configLoaded
      if fileSyncSupported
        = ui-sync-switch on=fileSync.enabled
        p click='showSyncFolder fileSync' Show Folder
      else
        p File Sync Not Supported!

      if sshAccessSupported
        p click='openSSHShell App.selectedContainer' Console
      else
        p Console not supported
    else
      p loading...
