<%
  case ENV['RACK_ENV']
  when 'production'
    host = 'https://pro.nitrous.io'
    signup_url = host + '/'
  else
    host = 'https://pro.n2ostaging.com'
    signup_url = host + '/'
  end

  puts "App VERSION: #{File.read(File.join(File.dirname(__FILE__), "..", "VERSION"))}"
%>

path = require 'path'

env = <%= "'#{ENV['RACK_ENV']}'" %>
debug = env == 'development' || process.env.DEBUG == '1'

asar = __dirname.match(/\.asar$/)?
resPath = if asar
  path.join(__dirname, '..')
else
  __dirname

appPath = switch process.platform
  when 'darwin'
    path.join(process.execPath, '..', '..', '..', '..', '..', '..')
  else
    path.join(process.execPath, '..')

module.exports =
  host: <%= "'#{host}'" %>
  signUpUrl: <%= "'#{signup_url}'" %>
  env: env
  debug: debug
  asar: asar
  resPath: resPath
  appPath: appPath
  updateLocation: "https://nitrous-pro-app.s3.amazonaws.com"
  version: "<%= File.read(File.join(File.dirname(__FILE__), "..", "VERSION")) %>"
