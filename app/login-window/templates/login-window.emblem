form submit=login class={invalidCredentials:shake}
  h1 Nitrous

  .fields
    = input class='username-field' value=username type='text' placeholder='Username or Email' disabled=loggingIn
    = input value=password type='password' placeholder='Password' disabled=loggingIn

  if loggingIn
    button.login-btn disabled='disabled'
      i.spinner
      | Logging in...
  else
    input.login-btn type='submit' value='Login' disabled=view.loginButtonDisabled

  .links
    p
      | Don't have an account?&nbsp;
      a href='#' click=signUp Sign Up
