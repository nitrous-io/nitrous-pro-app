#!/bin/bash
set -e

build_env=$1
build_env=${build_env:='development'}

atom_shell_ver=$2
atom_shell_ver=${atom_shell_ver:='0.18.2'}

if [ $build_env == "production" ]; then
  dist/darwin-x64/Nitrous.app/Contents/MacOS/Nitrous
else
  atom-shell/"$atom_shell_ver"/darwin-x64/Atom.app/Contents/MacOS/Atom ./build/development
fi
