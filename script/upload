#!/bin/bash

BUCKET_NAME="nitrous-pro-app"
S3_URL="https://nitrous-pro-app.s3.amazonaws.com"
CFRONT_URL="http://getpro.nitrous.io"
thisOS=`uname`

s3cmdBase=""
if [[ -z "$AWS_ACCESS_KEY" && -z "$AWS_SECRET_KEY" ]]; then
  s3cmdBase="s3cmd --no-preserve"
else
  s3cmdBase="s3cmd --access_key=$AWS_ACCESS_KEY --secret_key=$AWS_SECRET_KEY --no-preserve"
fi

for target in ./dist/*; do
  distType=""
  if [[ $target == *darwin-x64* ]]; then
    distType="mac"
  elif [[ $target == *linux-x64* ]]; then
    distType="linux"
  elif [[ $target == *win32-ia32* ]]; then
    distType="windows"
  fi

  if [[ $distType != "" ]]; then
    cd $target
    foundFile=""
    for file in *; do
      if [[ $file =~ ^(Nitrous|nitrous).+\.zip ]]; then
        foundFile=$file
      fi
    done
    if [[ $foundFile =~ -(.+)\.zip ]]; then
      thisVersion="${BASH_REMATCH[1]}"
      jsonUrl="$S3_URL/$distType/app.json"
      jsonContents=`curl $jsonUrl 2>/dev/null`
      expected="\"version\": \"$thisVersion\""
      finalUrl="$S3_URL/$distType/$foundFile"
      cdnUrl="$CFRONT_URL/$distType/$foundFile"
      if ! [ "${jsonContents/$expected}" = "$jsonContents" ] ; then
        echo "[$distType] Version $thisVersion already exists!"
      else
        echo "[$distType] Version $thisVersion does not exist, will upload."
        fileSize=""
        if [[ $thisOS == "Darwin" ]]; then
          fileSize=$(stat -f%z "$foundFile")
        else
          fileSize=$(stat -c%s "$foundFile")
        fi
        appJson="{ \"version\": \"$thisVersion\", \"url\": \"$finalUrl\", \"fileSize\": $fileSize }"
        $s3cmdBase put -P $foundFile s3://$BUCKET_NAME/$distType/$foundFile
        tmpLoc="/tmp/$foundFile.json"
        echo $appJson > $tmpLoc
        $s3cmdBase put -m "application/json" -P $tmpLoc s3://$BUCKET_NAME/$distType/app.json
        rm -rf $tmpLoc
      fi

      downloadUrl="$S3_URL/$distType/download.html"
      downloadContents=`curl $downloadUrl 2>/dev/null`
      if ! [ "${downloadContents/$cdnUrl}" = "$downloadContents" ] ; then
        echo "[$distType] download.html for Version $thisVersion already exists!"
      else
        downloadSource="<html><head><meta http-equiv=\"refresh\" content=\"0; url=$cdnUrl\"></head><body></body></html>"
        tmpDownload="/tmp/$foundFile.html"
        echo $downloadSource > $tmpDownload
        $s3cmdBase put $tmpDownload s3://$BUCKET_NAME/$distType/download.html -P --cf-invalidate --add-header="Cache-Control:max-age=600" --add-header="x-amz-website-redirect-location:$cdnUrl"
        rm -rf $tmpDownload
      fi
    else
      echo "No version found"
    fi
    cd ../../
  fi
done