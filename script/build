#!/bin/bash
set -e
BUILD_DIR=./build

build_env=$1
build_env=${build_env:='production'}

cd rails
rm -f public/index.html
rm -rf public/assets
mkdir -p public/assets
RACK_ENV="$build_env" bundle exec rake assets:clean assets:precompile
bundle exec rails runner -e "$build_env" 'puts ActionView::Base.new(Rails::Application::Configuration.new(Rails.root).paths["app/views"]).render(template: "web_app/index")' > public/index.html
cd ..

rm -rf "$BUILD_DIR"
mkdir "$BUILD_DIR"
mv rails/public/index.html "$BUILD_DIR"
mv rails/public/assets/* "$BUILD_DIR"
cp -a images "$BUILD_DIR"
rm -f "$BUILD_DIR"/manifest-*.json

cp -a ./bin "$BUILD_DIR"
