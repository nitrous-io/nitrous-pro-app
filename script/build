#!/bin/bash
set -e

build_env=$1
build_env=${build_env:='development'}

atom_shell_ver=$2
atom_shell_ver=${atom_shell_ver:='0.18.2'}

BUILD_DIR=./build/"$build_env"

cd rails
rm -f public/index.html
rm -rf public/assets
rm -rf tmp/
mkdir -p public/assets
RACK_ENV="$build_env" bundle exec rake assets:clean assets:precompile
bundle exec rails runner -e "$build_env" 'puts ActionView::Base.new(Rails::Application::Configuration.new(Rails.root).paths["app/views"]).render(template: "web_app/index")' > public/index.html
cd ..

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
mv rails/public/index.html "$BUILD_DIR"
mv rails/public/assets/* "$BUILD_DIR"
cp -a images "$BUILD_DIR"
rm -f "$BUILD_DIR"/manifest-*.json

if [ $build_env == "production" ]; then
  version=`cat ./VERSION`
  echo "Version: '$version'"
  rm -rf dist
  mkdir -p dist

  asar_path=dist/app.asar
  asar pack "$BUILD_DIR" "$asar_path"

  echo "--> Building OS X Package..."
  mkdir -p dist/darwin-x64
  echo $version > dist/darwin-x64/VERSION
  cp -a atom-shell/"$atom_shell_ver"/darwin-x64/Atom.app dist/darwin-x64/Nitrous.app
  app_path="dist/darwin-x64/Nitrous.app"
  contents_path="$app_path"/Contents
  resources_path=$contents_path/Resources
  rm -f "$contents_path"/Info.plist
  mv "$contents_path"/MacOS/Atom "$contents_path"/MacOS/Nitrous
  rm -f "$resources_path"/atom.icns
  cp resources/icon.icns "$resources_path"/atom.icns
  cp ./Info.plist "$contents_path"
  cp "$asar_path" "$resources_path"
  mkdir -p "$resources_path"/bin
  cp -a bin/osx "$resources_path"/bin
  cp -a images "$resources_path/images"

  find . -name '*.DS_Store' -type f -delete

  # code sign
  sig='4A935863DFF7D879E4487FC3FE1AF30EA03FAF00'
  codesign -f -v -s "$sig" "$resources_path"/app.asar
  for f in nitrous-ssh-launcher nitrous-unison nitrous-unison.sh nitrous-watcher nitrous-update.sh nitrous-update-invoker.sh; do
    codesign -f -v -s "$sig" "$resources_path"/bin/osx/"$f"
  done
  codesign -f --deep -v -s "$sig" $app_path
  echo "...Done!"

  echo "--> Building Windows Package..."
  mkdir -p dist/win32-ia32
  echo $version > dist/win32-ia32/VERSION
  app_path='dist/win32-ia32/Nitrous'
  resources_path="$app_path"/resources
  cp -a atom-shell/"$atom_shell_ver"/win32-ia32 "$app_path"
  rm -f "$app_path"/atom.exe
  cp "$asar_path" "$resources_path"
  mkdir -p "$resources_path"/bin
  cp -a bin/win "$resources_path"/bin
  cp -a images "$resources_path/images"
  echo "...Done!"

  echo "--> Building Linux Package..."
  mkdir -p dist/linux-x64
  echo $version > dist/linux-x64/VERSION
  app_path='dist/linux-x64/Nitrous'
  resources_path="$app_path"/resources
  cp -a atom-shell/"$atom_shell_ver"/linux-x64 "$app_path"
  mv "$app_path"/atom "$app_path"/nitrous
  chmod +x "$app_path"/nitrous
  cp "$asar_path" "$resources_path"
  mkdir -p "$resources_path"/bin
  cp -a bin/linux "$resources_path"/bin
  cp -a images "$resources_path/images"
  echo "...Done!"
else
  cp -a bin "$BUILD_DIR"
fi
