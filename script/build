#!/bin/bash
set -e

build_env=$1
build_env=${build_env:='development'}

atom_shell_ver=$2
atom_shell_ver=${atom_shell_ver:='0.18.2'}

BUILD_DIR=./build/"$build_env"

cd rails
rm -f public/index.html
rm -rf public/assets
mkdir -p public/assets
RACK_ENV="$build_env" bundle exec rake assets:clean assets:precompile
bundle exec rails runner -e "$build_env" 'puts ActionView::Base.new(Rails::Application::Configuration.new(Rails.root).paths["app/views"]).render(template: "web_app/index")' > public/index.html
cd ..

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
mv rails/public/index.html "$BUILD_DIR"
mv rails/public/assets/* "$BUILD_DIR"
cp -a images "$BUILD_DIR"
rm -f "$BUILD_DIR"/manifest-*.json

if [ $build_env == "production" ]; then
  rm -rf dist
  mkdir -p dist/darwin-x64
  cp -a atom-shell/"$atom_shell_ver"/darwin-x64/Atom.app dist/darwin-x64/Nitrous.app
  contents_path="dist/darwin-x64/Nitrous.app/Contents"
  resources_path=$contents_path/Resources
  rm -f "$contents_path"/Info.plist
  mv "$contents_path"/MacOS/Atom "$contents_path"/MacOS/Nitrous
  rm -f "$resources_path"/atom.icns
  cp resources/icon.icns "$resources_path"/atom.icns
  cp ./Info.plist "$contents_path"
  asar pack "$BUILD_DIR" "$resources_path"/app.asar
  mkdir -p "$resources_path"/bin
  cp -a bin/osx "$resources_path"/bin
else
  cp -a bin "$BUILD_DIR"
fi
